# ============================================
# Pandaverse Gharana Partner Portal
# Environment Variables
# ============================================

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (used ONLY on the server side in API routes)
# This bypasses RLS — keep it secret, never expose it to the browser
# Get it from: https://app.supabase.com/project/_/settings/api (Service Role section)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
